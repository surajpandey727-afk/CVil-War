# =============================================================================
# CVil-War — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///data/db/cvilwar.db
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
# Production runs on Claude through the Anthropic API. The key is read ONLY from this
# variable (never stored in the database or logs).
ANTHROPIC_API_KEY=
LLM__PREFERRED_PROVIDER=anthropic
LLM__DEFAULT_MODEL=anthropic/claude-sonnet-5-5
# Cheap classification calls (email triage, small labels).
LLM__CLASSIFY_MODEL=anthropic/claude-haiku-5-5
# Explicit fallback models, tried in order when the default fails.
LLM__FALLBACK_MODELS=["anthropic/claude-haiku-5-5"]
# Optional: résumé-tailoring planning model. Empty = LLM__DEFAULT_MODEL.
LLM__PLAN_MODEL=
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=4096
# Optional OpenAI-compatible local gateway (e.g. OmniRoute). Anthropic models never go
# through it; everything else does when this is set.
LLM__API_BASE=
LLM__API_BASE_KEY=
# Other providers, only if you route models to them:
LLM__OPENAI_API_KEY=
LLM__GROQ_API_KEY=
LLM__GEMINI_API_KEY=
LLM__OPENROUTER_API_KEY=

# --- Job sources (discovery; no account needed) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
# Keep the deployment at zero running cost (skips paid sources).
ZERO_COST_MODE=true

# --- Browser Automation ---
BROWSER__HEADLESS=true
BROWSER__MAX_PARALLEL=3
# To reuse your existing Chrome sessions (LinkedIn, Indeed, etc.):
# Point this to your real Chrome profile directory:
# Windows: C:/Users/<you>/AppData/Local/Google/Chrome/User Data
# Mac: ~/Library/Application Support/Google/Chrome
# Or leave default for a standalone profile:
BROWSER__USER_DATA_DIR=./data/sessions/chrome_profile
BROWSER__KEEP_ALIVE=true
BROWSER__MAX_STEPS=50
BROWSER__MAX_FAILURES=3
BROWSER__STEP_TIMEOUT=120
BROWSER__USE_VISION=auto

# --- Job Discovery ---
# Exa AI semantic search for finding jobs across the web (optional)
EXA_API_KEY=
# How often the background worker polls every user's enabled sources for new listings
# (minutes, 5-60). This is what actually populates the dashboard without a manual search.
DISCOVERY_INTERVAL_MINUTES=30

# --- Communications (Apollo outbound tracking, Gmail inbound reply detection) ---
# Apollo.io API key — logs recruiter contacts against an application (optional).
APOLLO_API_KEY=
# Google Cloud OAuth client (console.cloud.google.com > APIs & Services > Credentials).
# Enable the Gmail API on the project, add a Web application OAuth client, and register
# GMAIL_REDIRECT_URI below as an authorised redirect URI on that client.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/communications/gmail/callback
# Where the Gmail OAuth callback sends your browser back to once done.
FRONTEND_URL=http://localhost:3000
# Shared secret for POST /api/v1/internal/* — lets a local automation tool (e.g. n8n) trigger
# a discovery or inbox-sync cycle on demand via `Authorization: Bearer <this value>`. Unset
# means those endpoints refuse every request (fail-closed). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_WEBHOOK_TOKEN=

# --- Application Behavior ---
APPLY_MODE=review
# Options: autonomous, review, batch
MIN_ATS_SCORE=0.75
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth & Security (multi-tenant) ---
# JWT signing secret — MUST be a strong random value in production.
AUTH__SECRET_KEY=dev-insecure-change-me
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH__WS_TICKET_EXPIRE_SECONDS=60

# --- Secrets (per-user BYO-key envelope encryption) ---
# Comma-separated Fernet keys (first = current KEK). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty outside production to auto-generate an ephemeral dev key.
SECRETS__PROVIDER=local
SECRETS__APP_KEYS=

# --- File Storage ---
STORAGE__PROVIDER=local
STORAGE__LOCAL_ROOT=./data/storage
STORAGE__URL_SIGNING_SECRET=dev-insecure-change-me
# For S3-compatible storage (AWS S3 / Cloudflare R2 / MinIO) set STORAGE__PROVIDER=s3 and:
# STORAGE__BUCKET=cvil-war
# STORAGE__REGION=auto
# STORAGE__ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# STORAGE__ACCESS_KEY_ID=
# STORAGE__SECRET_ACCESS_KEY=

# --- Server ---
CORS_ORIGINS=["http://localhost:5174", "http://localhost:5173"]
# Where links in emails and OAuth redirects point (the Vite dev server runs on 5174).
FRONTEND_URL=http://localhost:5174

# --- Production / hosted deployment ---
# File storage on Supabase (STORAGE__PROVIDER=supabase).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# inline (run in the request), arq (Redis worker) or db_queue (an always-on machine polls
# the database - what the Vercel deployment uses, see docs/LOCAL_SETUP.md).
APPLY_DISPATCH=inline
# Shared secret the daily Vercel cron sends to /internal/cron/daily.
CRON_SECRET=
SENTRY_DSN=

# --- Job-board sign-ins ---
# None here, on purpose. CVil-War never asks for or stores a job-board password: you sign in
# yourself once in a browser window it opens (Settings -> Platforms -> Connect), and only the
# resulting session is kept, encrypted with SECRETS__APP_KEYS.
