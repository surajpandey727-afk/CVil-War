# Local-stack image for the API, the arq worker and the one-shot `migrate` service
# (docker-compose.yml builds all three from this file).
#
# Python 3.12 to match CI and the Vercel runtime. Dependencies install against
# backend/constraints.txt — the uv-compiled resolution of pyproject.toml — because pip's own
# resolver hits `resolution-too-deep` on this graph and the build failed outright (D-013/D-014).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONPATH=/app

# WeasyPrint (PDF render) runtime libraries. libgdk-pixbuf2.0-0 was renamed
# libgdk-pixbuf-2.0-0 upstream; the slim image tracks Debian trixie, where the old name has no
# installation candidate.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    libffi-dev libcairo2 libglib2.0-0 fonts-liberation fonts-crosextra-carlito \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first, in their own layer, so a code change does not reinstall the world.
# A stub package lets `pip install .` resolve without the real source.
COPY backend/pyproject.toml backend/constraints.txt ./
# pip 25.0.x (the base image's) crashes evaluating the constraint file's python_full_version
# markers when extras are requested; CI upgrades pip for the same reason.
RUN pip install --upgrade "pip>=25.1" \
    && mkdir app && touch app/__init__.py \
    && pip install -c constraints.txt ".[postgres,aws]" \
    && python -m spacy download en_core_web_sm \
    && playwright install chromium --with-deps \
    && chmod -R a+rx /ms-playwright \
    && pip uninstall -y cvil-war-backend \
    && rm -rf app build

# alembic.ini is required by the compose `migrate` service (`alembic upgrade head`).
COPY backend/alembic.ini ./
COPY backend/app/ ./app/
COPY backend/scripts/ ./scripts/
# Jinja/WeasyPrint document templates resolve via a relative "templates" path from /app.
COPY templates/ ./templates/

RUN useradd -m appuser \
    && mkdir -p data/db data/storage data/sessions data/generated data/uploads \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
